{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["uid", "role", "status"],
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "lastLogin": {
          ".write": "auth != null && auth.uid === $userId"
        }
      }
    },

    "requisitions": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["status", "programme", "Programme", "uid", "submittedBy", "createdAt", "submittedAt", "timestamp"],
      "$recordId": {
        ".read": "auth != null",
        ".write": "auth != null || !data.exists()",
        "history": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".indexOn": ["timestamp", "createdAt"],
          "$historyId": {
            ".write": "auth != null"
          }
        }
      }
    },

    "capacityBuilding": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["programme", "Programme", "submittedBy", "createdAt", "startDate", "rawTimestamp", "timestamp"],
      "$recordId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "orders": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["programme", "Programme", "createdAt", "completedAt", "date", "timestamp"],
      "$recordId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "farmers": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["programme", "Programme", "createdAt", "registrationDate", "timestamp"],
      "$recordId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "fodderFarmers": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["programme", "Programme", "createdAt", "registrationDate", "timestamp"],
      "$recordId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "offtakes": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["programme", "Programme", "createdAt", "date", "Date", "timestamp"],
